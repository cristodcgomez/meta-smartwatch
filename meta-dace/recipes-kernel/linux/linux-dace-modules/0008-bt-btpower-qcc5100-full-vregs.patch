From: TicWatch Pro 5 port
Subject: [PATCH] bt: btpower: rieles completos (io/core/pa/xtal) para qcc5100

En monaco el BT comparte rieles con el WLAN: IO=L17A (1.8V),
core/RFA=L13A (1.304V), PA/CH0=L26A (3.0-3.304V), XO=L14A (1.8V) -- valores
del DTSI stock monaco-standalone-idp-v1.dtsi. La tabla generica de qcc5100
solo declara 'pa' y a 1.7-1.9V, por lo que bluetooth_power(1) no encendia io
ni core: el chip de BT se quedaba SIN ALIMENTAR (pm5100_l13/l17 en 'disabled'
en /sys/class/regulator) y no contestaba al handshake del HAL (abre ttyHS0 a
2400 bps y muere con 'InitTimeOut' + 'UART driver returns err code = 0x55').
Con soc=slate el HAL de BT no vota reguladores ("FOR SLATE not voting any
Regulators"), asi que este enable es el UNICO camino para alimentar el chip.

Upstream-Status: Inappropriate [dace bring-up]
---

--- a/private/msm-google-modules/bt/pwr/btpower.c	2026-09-20 19:56:40.346339722 +0200
+++ b/private/msm-google-modules/bt/pwr/btpower.c	2026-09-20 19:56:40.360100598 +0200
@@ -179,9 +179,22 @@
 };
 
 // Regulator structure for QCC5100 BT SoC series
+// dace: en monaco (SW5100/TicWatch Pro 5) el BT comparte rieles con el WLAN:
+// IO=L17A (1.8V), core/RFA=L13A (1.304V), PA/CH0=L26A (3.0-3.304V), XO=L14A
+// (1.8V) -- valores del DTSI stock monaco-standalone-idp-v1.dtsi. La tabla
+// generica de qcc5100 solo trae 'pa' y a 1.7-1.9V, asi que bluetooth_power(1)
+// NO encendia io/core: el chip se quedaba SIN ALIMENTAR y mudo (handshake a
+// 2400 bps -> err 0x55). Con soc=slate el HAL no vota reguladores ("FOR SLATE
+// not voting any Regulators"), asi que este enable es el UNICO camino.
 static struct bt_power_vreg_data bt_vreg_info_qcc5xxx[] = {
-	{NULL, "qcom,bt-vdd-pa", 1700000, 1900000, 0, false, false,
+	{NULL, "qcom,bt-vdd-io",   1700000, 1900000, 0, false, false,
+			{BT_VDD_IO_LDO, BT_VDD_IO_LDO_CURRENT}},
+	{NULL, "qcom,bt-vdd-core", 1304000, 1304000, 0, false, false,
+			{BT_VDD_CORE_LDO, BT_VDD_CORE_LDO_CURRENT}},
+	{NULL, "qcom,bt-vdd-pa",   3000000, 3312000, 0, false, false,
 			{BT_VDD_PA_LDO, BT_VDD_PA_LDO_CURRENT}},
+	{NULL, "qcom,bt-vdd-xtal", 1700000, 1900000, 0, false, false,
+			{BT_VDD_XTAL_LDO, BT_VDD_XTAL_LDO_CURRENT}},
 };
 
 static struct bt_power bt_vreg_info_qca6174 = {
