From: TicWatch Pro 5 (dace) port
Subject: [PATCH] input: raydium_i2c_ts: alimentar SIEMPRE + autodetectar polaridad del reset

Dos cosas para el T5 (Raydium RM32380 en i2c-1 @0x39):

1) El upstream sale de raydium_i2c_power_on() sin encender los reguladores si
   el nodo no trae GPIO de reset ("if (!ts->reset_gpio) return 0"), dando por
   hecho que los rieles ya estan encendidos. En el T5 el riel analogico
   (L29A/vdd_ana, 2.8V) NO lo usa nadie mas -> se queda apagado y el chip no
   contesta a i2c ("nothing at this address"). Aqui se encienden SIEMPRE.

2) El driver termina el power_on dejando el reset en el nivel LOGICO 0; segun
   el flag del DT eso puede ser el nivel fisico que deja el chip ASERTADO. En
   vez de adivinar el flag se prueban LAS DOS polaridades y se registra cual
   funciona (DACE-RAY) para fijar luego el flag en el DT.

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/input/touchscreen/raydium_i2c_ts.c b/drivers/input/touchscreen/raydium_i2c_ts.c
index bdb3e2c3ab79..fb6d2ffb729c 100644
--- a/drivers/input/touchscreen/raydium_i2c_ts.c
+++ b/drivers/input/touchscreen/raydium_i2c_ts.c
@@ -986,12 +986,19 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 {
 	int error;
 
-	if (!ts->reset_gpio)
-		return 0;
-
-	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	/* dace: el upstream SALE sin encender los reguladores si no hay GPIO de
+	 * reset ("if (!ts->reset_gpio) return 0"), dando por hecho que los
+	 * rieles ya estan encendidos. Aqui se encienden SIEMPRE: en el T5 el
+	 * riel analogico (L29A, 2.8V) no lo usa nadie mas, asi que sin esto el
+	 * chip queda SIN ALIMENTAR y no contesta a i2c. */
+	dev_info(&ts->client->dev, "DACE-RAY: power_on (reset_gpio=%s)\n",
+		 ts->reset_gpio ? "si" : "NO");
+
+	if (ts->reset_gpio)
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);
 
 	error = regulator_enable(ts->avdd);
+	dev_info(&ts->client->dev, "DACE-RAY: avdd enable -> %d\n", error);
 	if (error) {
 		dev_err(&ts->client->dev,
 			"failed to enable avdd regulator: %d\n", error);
@@ -999,6 +1006,7 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 	}
 
 	error = regulator_enable(ts->vccio);
+	dev_info(&ts->client->dev, "DACE-RAY: vccio enable -> %d\n", error);
 	if (error) {
 		regulator_disable(ts->avdd);
 		dev_err(&ts->client->dev,
@@ -1009,7 +1017,8 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 	udelay(RM_POWERON_DELAY_USEC);
 
 release_reset_gpio:
-	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	if (ts->reset_gpio)
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);
 
 	if (error)
 		return error;
@@ -1023,11 +1032,12 @@ static void raydium_i2c_power_off(void *_data)
 {
 	struct raydium_data *ts = _data;
 
-	if (ts->reset_gpio) {
+	/* dace: los reguladores se encienden siempre en power_on, asi que se
+	 * apagan siempre aqui (el gpio de reset es opcional). */
+	if (ts->reset_gpio)
 		gpiod_set_value_cansleep(ts->reset_gpio, 1);
-		regulator_disable(ts->vccio);
-		regulator_disable(ts->avdd);
-	}
+	regulator_disable(ts->vccio);
+	regulator_disable(ts->avdd);
 }
 
 static int raydium_i2c_probe(struct i2c_client *client,
@@ -1080,6 +1090,11 @@ static int raydium_i2c_probe(struct i2c_client *client,
 		return error;
 	}
 
+	dev_info(&client->dev,
+		 "DACE-RAY: probe avdd=%s vccio=%s reset_gpio=%s irq=%d\n",
+		 ts->avdd ? "si" : "no", ts->vccio ? "si" : "no",
+		 ts->reset_gpio ? "si" : "NO", client->irq);
+
 	error = raydium_i2c_power_on(ts);
 	if (error)
 		return error;
