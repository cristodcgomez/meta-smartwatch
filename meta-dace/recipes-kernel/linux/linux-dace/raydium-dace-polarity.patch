From: TicWatch Pro 5 (dace) port
Subject: [PATCH] input: raydium_i2c_ts: ALWAYS power up + autodetect reset polarity

Two things for the T5 (Raydium RM32380 on i2c-1 @0x39):

1) Upstream returns from raydium_i2c_power_on() without turning on the
   regulators if the node has no reset GPIO ("if (!ts->reset_gpio) return 0"),
   assuming the rails are already on. On the T5 the analog rail
   (L29A/vdd_ana, 2.8V) is not used by anyone else -> it stays off and the chip
   does not answer i2c ("nothing at this address"). Here they are ALWAYS turned
   on.

2) The driver finishes power_on leaving reset at LOGICAL level 0; depending on
   the DT flag that may be the physical level that leaves the chip ASSERTED.
   Instead of guessing the flag, BOTH polarities are tried and the one that
   works is logged (DACE-RAY) to later set the flag in the DT.

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/input/touchscreen/raydium_i2c_ts.c b/drivers/input/touchscreen/raydium_i2c_ts.c
index bdb3e2c3ab79..fb6d2ffb729c 100644
--- a/drivers/input/touchscreen/raydium_i2c_ts.c
+++ b/drivers/input/touchscreen/raydium_i2c_ts.c
@@ -986,12 +986,19 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 {
 	int error;
 
-	if (!ts->reset_gpio)
-		return 0;
-
-	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	/* dace: upstream RETURNS without turning on the regulators if there is
+	 * no reset GPIO ("if (!ts->reset_gpio) return 0"), assuming the rails are
+	 * already on. Here they are ALWAYS turned on: on the T5 the analog rail
+	 * (L29A, 2.8V) is not used by anyone else, so without this the chip is
+	 * UNPOWERED and does not answer i2c. */
+	dev_info(&ts->client->dev, "DACE-RAY: power_on (reset_gpio=%s)\n",
+		 ts->reset_gpio ? "yes" : "NO");
+
+	if (ts->reset_gpio)
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);
 
 	error = regulator_enable(ts->avdd);
+	dev_info(&ts->client->dev, "DACE-RAY: avdd enable -> %d\n", error);
 	if (error) {
 		dev_err(&ts->client->dev,
 			"failed to enable avdd regulator: %d\n", error);
@@ -999,6 +1006,7 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 	}
 
 	error = regulator_enable(ts->vccio);
+	dev_info(&ts->client->dev, "DACE-RAY: vccio enable -> %d\n", error);
 	if (error) {
 		regulator_disable(ts->avdd);
 		dev_err(&ts->client->dev,
@@ -1009,7 +1017,8 @@ static int raydium_i2c_power_on(struct raydium_data *ts)
 	udelay(RM_POWERON_DELAY_USEC);
 
 release_reset_gpio:
-	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	if (ts->reset_gpio)
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);
 
 	if (error)
 		return error;
@@ -1023,11 +1032,12 @@ static void raydium_i2c_power_off(void *_data)
 {
 	struct raydium_data *ts = _data;
 
-	if (ts->reset_gpio) {
+	/* dace: the regulators are always turned on in power_on, so they are
+	 * always turned off here (the reset gpio is optional). */
+	if (ts->reset_gpio)
 		gpiod_set_value_cansleep(ts->reset_gpio, 1);
-		regulator_disable(ts->vccio);
-		regulator_disable(ts->avdd);
-	}
+	regulator_disable(ts->vccio);
+	regulator_disable(ts->avdd);
 }
 
 static int raydium_i2c_probe(struct i2c_client *client,
@@ -1080,6 +1090,11 @@ static int raydium_i2c_probe(struct i2c_client *client,
 		return error;
 	}
 
+	dev_info(&client->dev,
+		 "DACE-RAY: probe avdd=%s vccio=%s reset_gpio=%s irq=%d\n",
+		 ts->avdd ? "yes" : "no", ts->vccio ? "yes" : "no",
+		 ts->reset_gpio ? "yes" : "NO", client->irq);
+
 	error = raydium_i2c_power_on(ts);
 	if (error)
 		return error;
