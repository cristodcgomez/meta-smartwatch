From: TicWatch Pro 5 (dace) port
Subject: [PATCH] iommu/arm/arm-smmu: dump the SMR/S2CR table and sCR0 (dace bring-up)

PURE telemetry (no behavior change) to solve the QUP DMA failure on dace: the
HS UART gives RX_SBE (bus error) and the slate GSI/GPI "general error" (0x40)
when the devices use PHYSICAL addresses (they have no IOMMU domain because
arm_smmu registers late). Hypotheses to resolve:

  a) the stream is not identified by any SMR and sCR0.USFCFG=1 aborts it
     (stock has no IOMMU driver -> sCR0 keeps the firmware value),
  b) the stream IS in the firmware table and its CB translates to a range that
     does not cover the physical address.

Three things are printed (prefix DACE-SMMU, err level so they reach the
initramfs USB console):
  - DACE-SMMU-SCR0 (from the firmware) and (want/read after our write): if the
    read does not match, the SMMU is locked by TZ and bypass CANNOT be changed
    with arm_smmu.disable_bypass=0.
  - DACE-SMMU-SMR: each real entry (idx/id/mask/type/privcfg/cbndx/pinned).
  - DACE-SMMU-MATCH: whether the streams we care about (0x000/0x001 display,
    0x0c0/0x0c1 eMMC, 0x0e3 QUP wrapper+UART, 0x0f6 slate GPI-DMA,
    0x420/0x422 DT handoff, 0x800/0x801/0x980/0x981 USB/SDE) match any entry.

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -2918,6 +2918,17 @@
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_TLBIALLNSNH, QCOM_DUMMY_VAL);
 
 	reg = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_sCR0);
+	/*
+	 * dace TELEMETRY (dace-smmu-telemetry.patch): sCR0 value left by the
+	 * firmware/bootloader BEFORE Linux rewrites it. If USFCFG=1 the
+	 * unidentified streams get ABORT instead of passing (bypass); the STOCK
+	 * kernel has no IOMMU driver -> this register stays as the firmware set it
+	 * and that is why stock works with physical addresses.
+	 */
+	dev_err(smmu->dev,
+		"DACE-SMMU-SCR0 (from firmware) = 0x%08x USFCFG=%d CLIENTPD=%d\n",
+		reg, !!(reg & ARM_SMMU_sCR0_USFCFG),
+		!(reg & ARM_SMMU_sCR0_CLIENTPD));
 
 	/* Enable fault reporting */
 	reg |= (ARM_SMMU_sCR0_GFRE | ARM_SMMU_sCR0_GFIE |
@@ -2955,6 +2966,14 @@
 	/* Push the button */
 	arm_smmu_tlb_sync_global(smmu);
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_sCR0, reg);
+	/* dace TELEMETRY: read back to see whether the SMMU accepts the write (if
+	 * it is locked by TZ, read != want and bypass cannot be changed from a
+	 * module parameter). */
+	dev_err(smmu->dev,
+		"DACE-SMMU-SCR0 want=0x%08x read=0x%08x USFCFG=%d CLIENTPD=%d disable_bypass=%d\n",
+		reg, arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_sCR0),
+		!!(reg & ARM_SMMU_sCR0_USFCFG), !(reg & ARM_SMMU_sCR0_CLIENTPD),
+		disable_bypass);
 }
 
 static int arm_smmu_id_size_to_bits(int size)
@@ -3592,6 +3611,54 @@
 	dev_err(smmu->dev,
 		"DACE-SMMU %s: firmware table: %d/%d SMR in use, %d context banks reserved\n",
 		dev_name(smmu->dev), used, smmu->num_mapping_groups, cbs);
+
+	/*
+	 * dace TELEMETRY (dace-smmu-telemetry.patch): dump the REAL SMR/S2CR
+	 * table left by the firmware and check whether the streams we care about
+	 * are MATCHed. Key to deciding the fix:
+	 *   - if 0xe3 (QUP/UART wrapper) and 0xf6 (GPI) are NOT matched, the DMA
+	 *     failure (UART RX_SBE, slate GSI GError) is the ABORT from
+	 *     sCR0.USFCFG on unidentified streams -> the fix is to let them pass
+	 *     (bypass); or give them a domain. If the firmware left USFCFG=0 in
+	 *     sCR0 (see DACE-SMMU-SCR0), stock did not identify them either.
+	 *   - if they ARE matched, the transaction is translated with the
+	 *     firmware CB and what fails is that this translation does not cover
+	 *     the physical address -> the fix is to give the devices a domain.
+	 */
+	for (i = 0; i < smmu->num_mapping_groups; ++i) {
+		if (!smmu->smrs[i].valid)
+			continue;
+		dev_err(smmu->dev,
+			"DACE-SMMU-SMR idx=%d id=0x%x mask=0x%x s2cr[type=%u privcfg=%u cbndx=%u pinned=%d count=%u]\n",
+			i, smmu->smrs[i].id, smmu->smrs[i].mask,
+			smmu->s2crs[i].type, smmu->s2crs[i].privcfg,
+			smmu->s2crs[i].cbndx, smmu->s2crs[i].pinned,
+			smmu->s2crs[i].count);
+	}
+	{
+		static const u16 dace_sids[] = {
+			0x000, 0x001, 0x0c0, 0x0c1, 0x0e3, 0x0f6, 0x420, 0x422,
+			0x800, 0x801, 0x980, 0x981,
+		};
+		u16 sid;
+
+		for (i = 0; i < ARRAY_SIZE(dace_sids); ++i) {
+			int j, hit = -1;
+
+			sid = dace_sids[i];
+			for (j = 0; j < smmu->num_mapping_groups; ++j) {
+				if (!smmu->smrs[j].valid)
+					continue;
+				if (!((sid ^ smmu->smrs[j].id) & ~smmu->smrs[j].mask)) {
+					hit = j;
+					break;
+				}
+			}
+			dev_err(smmu->dev,
+				"DACE-SMMU-MATCH sid=0x%03x -> idx=%d [%s]\n",
+				sid, hit, hit >= 0 ? "MATCHED" : "NO MATCH (USFCFG decides)");
+		}
+	}
 }
 
 static int arm_smmu_device_probe(struct platform_device *pdev)
