From: TicWatch Pro 5 (dace) port
Subject: [PATCH] input: touchscreen: zinitix: hardware reset + chip IDs

The T5 has a Zinitix on i2c-1 @0x20 (node zinitix_ts@20) with
compatible "zinitix,zinitix-ts", which the mainline driver did not accept
(only "zinitix,bt541") -> it was added by fdtput. With that the driver probes,
and with the vddo-supply (regulator_bulk_get asks for vdd+vddo) and the
touchscreen-size-x/y (touchscreen_parse_properties) it reaches the end of probe.

It also pulses the HARDWARE RESET (the T5 DT declares it with the vendor name:
zinitix,reset-gpio = <0x69 0x0c 0x00>, TLMM gpio 12; here the STANDARD
reset-gpios property is used, added by fdtput) and turns on the THREE regulators
of the node. Measured on the watch: with only vdd+vddo the chip does NOT answer
at its i2c address and zinitix_start returns -107 (-ENOTCONN = I2C_ADDR_NACK).

It also prints the chip IDs (rev/fw/vendor/hw) at init, to be able to confirm
that it is a compatible BT541 (the node declares zinitix,pname="SM-G5308W" and
x/y_resolution=0x1d1=465, the panel resolution).

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/input/touchscreen/zinitix.c b/drivers/input/touchscreen/zinitix.c
index 400957f4c8c9..4620a04ce420 100644
--- a/drivers/input/touchscreen/zinitix.c
+++ b/drivers/input/touchscreen/zinitix.c
@@ -1,12 +1,17 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
 #include <linux/interrupt.h>
 #include <linux/irq.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/soc/qcom/panel_event_notifier.h>
+#include <drm/drm_panel.h>
+#include <linux/completion.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -144,8 +149,32 @@ struct bt541_ts_data {
 	struct i2c_client *client;
 	struct input_dev *input_dev;
 	struct touchscreen_properties prop;
-	struct regulator_bulk_data supplies[2];
+	struct regulator_bulk_data supplies[4];
+	/* Hardware reset: the T5 DT declares 'zinitix,reset-gpio' (TLMM gpio 12)
+	 * and the vendor driver pulses it at start. The mainline did not look at
+	 * it: the chip answered over i2c but did not report touches (the IRQ
+	 * never fired). */
+	struct gpio_desc *reset_gpio;
+	/* pinctrl: the vendor driver DOES select the node states
+	 * (pmx_ts_active/suspend/release), which configure gpio12 (reset) and
+	 * gpio13 (irq, with bias-pull-up). The mainline did not touch them. */
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *pins_active;
+	struct pinctrl_state *pins_suspend;
+	/* panel: the vendor driver only powers the chip when the DSI panel is
+	 * active (active_panel + panel_event_notifier). It is registered here and
+	 * it waits (once) for UNBLANK before the power-on sequence. */
+	struct drm_panel *panel;
+	void *panel_cookie;
+	bool panel_allow_tn;
+	bool panel_waited;
+	struct completion panel_unblank;
 	u32 zinitix_mode;
+	int reset_try;
+	/* dace: periodic polling of the points register (to know whether the chip
+	 * scans even if the IRQ does not fire) */
+	struct delayed_work dace_poll;
+	bool dace_poll_running;
 };
 
 static int zinitix_read_data(struct i2c_client *client,
@@ -247,9 +276,86 @@ static int zinitix_init_touch(struct bt541_ts_data *bt541)
 		udelay(10);
 	}
 
+	/* dace: chip identity (to compare with the driver's bt541) */
+	{
+		u16 rev = 0, fw = 0, vid = 0, hwid = 0;
+		if (!zinitix_read_data(client, BT541_CHIP_REVISION, &rev, 2) &&
+		    !zinitix_read_data(client, BT541_FIRMWARE_VERSION, &fw, 2) &&
+		    !zinitix_read_data(client, BT541_VENDOR_ID, &vid, 2) &&
+		    !zinitix_read_data(client, BT541_HW_ID, &hwid, 2))
+			dev_info(&client->dev,
+				 "DACE-TS: chip rev=%u fw=%u vendor=%u hw=%u mode=%u\n",
+				 rev, fw, vid, hwid, bt541->zinitix_mode);
+		else
+			dev_info(&client->dev,
+				 "DACE-TS: could not read the chip IDs\n");
+	}
+
 	return 0;
 }
 
+/* dace bring-up: scan ALL i2c buses to know whether the subsystem works and on
+ * which bus/address something answers. The touch chip does not respond at 0x20
+ * on i2c-1 -> -ENOTCONN (=I2C_ADDR_NACK), and the DT node is Samsung
+ * boilerplate (zinitix,pname="SM-G5308W"), so we must confirm that the touch is
+ * really on THAT bus. */
+static void zinitix_dace_i2c_scan(struct i2c_client *client)
+{
+	int nr, addr;
+
+	for (nr = 0; nr < 16; nr++) {
+		struct i2c_adapter *adap = i2c_get_adapter(nr);
+		int found = 0;
+		u8 val;
+
+		if (!adap)
+			continue;
+		for (addr = 0x08; addr < 0x78; addr++) {
+			struct i2c_msg msg = {
+				.addr = addr,
+				.flags = I2C_M_RD,
+				.len = 1,
+				.buf = &val,
+			};
+			if (i2c_transfer(adap, &msg, 1) == 1) {
+				dev_info(&client->dev,
+					 "DACE-SCAN: i2c-%d 0x%02x responds\n",
+					 nr, addr);
+				found++;
+			}
+		}
+		dev_info(&client->dev, "DACE-SCAN: i2c-%d (%s) done, %d dev\n",
+			 nr, adap->name, found);
+		i2c_put_adapter(adap);
+	}
+}
+
+static void zinitix_panel_event_handler(enum panel_event_notifier_tag tag,
+					struct panel_event_notification *notif,
+					void *pvt_data)
+{
+	struct bt541_ts_data *bt541 = pvt_data;
+
+	if (!notif)
+		return;
+
+	dev_info(&bt541->client->dev, "DACE-TS: panel event %d\n",
+		 notif->notif_type);
+
+	switch (notif->notif_type) {
+	case DRM_PANEL_EVENT_UNBLANK:
+		bt541->panel_allow_tn = true;
+		complete(&bt541->panel_unblank);
+		break;
+	case DRM_PANEL_EVENT_BLANK:
+	case DRM_PANEL_EVENT_BLANK_LP:
+		bt541->panel_allow_tn = false;
+		break;
+	default:
+		break;
+	}
+}
+
 static int zinitix_init_regulators(struct bt541_ts_data *bt541)
 {
 	struct i2c_client *client = bt541->client;
@@ -257,6 +363,14 @@ static int zinitix_init_regulators(struct bt541_ts_data *bt541)
 
 	bt541->supplies[0].supply = "vdd";
 	bt541->supplies[1].supply = "vddo";
+	/* dace: the T5 node declares FOUR rails (vdd=0x84, vdd-v1=0x83,
+	 * vcc_i2c=0x85) and the vendor driver turns them all on. The mainline
+	 * only knew vdd+vddo and with that the chip does NOT answer at its i2c
+	 * address: zinitix_start -> "power-on sequence: -107" (-107 = -ENOTCONN =
+	 * I2C_ADDR_NACK, i2c-msm-geni.c:200). The other two are added by the name
+	 * they already have in the DT (no need to touch the DT). */
+	bt541->supplies[2].supply = "vdd-v1";
+	bt541->supplies[3].supply = "vcc_i2c";
 	error = devm_regulator_bulk_get(&client->dev,
 					ARRAY_SIZE(bt541->supplies),
 					bt541->supplies);
@@ -265,6 +379,10 @@ static int zinitix_init_regulators(struct bt541_ts_data *bt541)
 		return error;
 	}
 
+	dev_info(&client->dev, "DACE-TS: regulators requested: %s+%s+%s+%s\n",
+		 bt541->supplies[0].supply, bt541->supplies[1].supply,
+		 bt541->supplies[2].supply, bt541->supplies[3].supply);
+
 	return 0;
 }
 
@@ -374,10 +492,34 @@ static irqreturn_t zinitix_ts_irq_handler(int irq, void *bt541_handler)
 	return IRQ_HANDLED;
 }
 
+static void zinitix_dace_poll(struct work_struct *work)
+{
+	struct bt541_ts_data *bt541 = container_of(to_delayed_work(work),
+						   struct bt541_ts_data,
+						   dace_poll);
+	static int last;
+	struct touch_event ev;
+	int error;
+
+	error = zinitix_read_data(bt541->client, BT541_POINT_STATUS_REG,
+				  &ev, sizeof(ev));
+	if (!error && (ev.finger_mask || ev.finger_mask != last)) {
+		dev_info(&bt541->client->dev,
+			 "DACE-POLL: finger_mask=0x%02x\n", ev.finger_mask);
+		last = ev.finger_mask;
+	}
+
+	if (bt541->dace_poll_running)
+		schedule_delayed_work(&bt541->dace_poll, msecs_to_jiffies(500));
+}
+
 static int zinitix_start(struct bt541_ts_data *bt541)
 {
 	int error;
 
+	dev_info(&bt541->client->dev, "DACE-TS: start (open) irq=%d\n",
+		 bt541->client->irq);
+
 	error = regulator_bulk_enable(ARRAY_SIZE(bt541->supplies),
 				      bt541->supplies);
 	if (error) {
@@ -388,7 +530,68 @@ static int zinitix_start(struct bt541_ts_data *bt541)
 
 	msleep(CHIP_ON_DELAY);
 
-	error = zinitix_send_power_on_sequence(bt541);
+	dev_info(&bt541->client->dev, "DACE-TS: regulators ON\n");
+
+	/* dace: NOTE — the multi-bus scanner right before the power-on sequence
+	 * leaves the SE in a state where the write to the chip fails with -107
+	 * (with the module that does NOT have it, the chip DOES initialize). It is
+	 * disabled; for a one-off diagnostic, uncomment. */
+	if (0)
+		zinitix_dace_i2c_scan(bt541->client);
+
+	/* ACTIVE pinctrl: configures gpio12 (reset) and gpio13 (irq, pull-up).
+	 * The vendor driver does it and the mainline does not. */
+	/* dace: NOTE — applying the 'pmx_ts_active' pinctrl here BREAKS the chip
+	 * start (it leaves reset in the wrong state -> -107). It is left
+	 * DISABLED: the pin is already configured by the reset gpiod.
+	if (bt541->pins_active) {
+		error = pinctrl_select_state(bt541->pinctrl, bt541->pins_active);
+		dev_info(&bt541->client->dev,
+			 "DACE-TS: pinctrl pmx_ts_active -> %d\n", error);
+	}
+	*/
+
+	/* Wait (only the first time) for the DSI panel to be awake: this is what
+	 * the vendor driver does before powering the chip. */
+	if (bt541->panel_cookie && !bt541->panel_allow_tn && !bt541->panel_waited) {
+		bt541->panel_waited = true;
+		if (!wait_for_completion_timeout(&bt541->panel_unblank,
+						 msecs_to_jiffies(1500)))
+			dev_info(&bt541->client->dev,
+				 "DACE-TS: no panel UNBLANK in 1.5s, continuing\n");
+		else
+			dev_info(&bt541->client->dev,
+				 "DACE-TS: panel UNBLANK received\n");
+	}
+
+	/* Reset + power-on with POLARITY AUTODETECTION: the T5 DT carries the
+	 * vendor flag (<&tlmm 0x0c 0>), and we do not know which physical level
+	 * it corresponds to. Both are tried (logic 1->0 and 0->1) and the one
+	 * that makes the chip answer is kept (the working one has no -ENOTCONN). */
+	for (bt541->reset_try = 0; bt541->reset_try < 2; bt541->reset_try++) {
+		if (bt541->reset_gpio) {
+			gpiod_set_value_cansleep(bt541->reset_gpio,
+						 bt541->reset_try ? 0 : 1);
+			msleep(20);
+			gpiod_set_value_cansleep(bt541->reset_gpio,
+						 bt541->reset_try ? 1 : 0);
+			msleep(150);
+			dev_info(&bt541->client->dev,
+				 "DACE-TS: reset pulsed (polarity %d)\n",
+				 bt541->reset_try);
+		}
+
+		error = zinitix_send_power_on_sequence(bt541);
+		if (!error) {
+			dev_info(&bt541->client->dev,
+				 "DACE-TS: power-on OK with polarity %d\n",
+				 bt541->reset_try);
+			break;
+		}
+		dev_info(&bt541->client->dev,
+			 "DACE-TS: power-on failed with polarity %d (%d)\n",
+			 bt541->reset_try, error);
+	}
 	if (error) {
 		dev_err(&bt541->client->dev,
 			"Error while sending power-on sequence: %d\n", error);
@@ -402,7 +605,17 @@ static int zinitix_start(struct bt541_ts_data *bt541)
 		return error;
 	}
 
+	dev_info(&bt541->client->dev, "DACE-TS: chip initialized\n");
+
 	enable_irq(bt541->client->irq);
+	dev_info(&bt541->client->dev, "DACE-TS: irq enabled\n");
+
+	if (!bt541->dace_poll_running) {
+		bt541->dace_poll_running = true;
+		schedule_delayed_work(&bt541->dace_poll,
+				      msecs_to_jiffies(500));
+		dev_info(&bt541->client->dev, "DACE-TS: i2c polling enabled\n");
+	}
 
 	return 0;
 }
@@ -413,6 +626,12 @@ static int zinitix_stop(struct bt541_ts_data *bt541)
 
 	disable_irq(bt541->client->irq);
 
+	bt541->dace_poll_running = false;
+	cancel_delayed_work_sync(&bt541->dace_poll);
+
+	if (bt541->pins_suspend)
+		pinctrl_select_state(bt541->pinctrl, bt541->pins_suspend);
+
 	error = regulator_bulk_disable(ARRAY_SIZE(bt541->supplies),
 				       bt541->supplies);
 	if (error) {
@@ -507,6 +726,65 @@ static int zinitix_ts_probe(struct i2c_client *client)
 	bt541->client = client;
 	i2c_set_clientdata(client, bt541);
 
+	bt541->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(bt541->reset_gpio))
+		return dev_err_probe(&client->dev, PTR_ERR(bt541->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+	/* node pinctrl (pmx_ts_active/suspend): like the vendor driver. */
+	bt541->pinctrl = devm_pinctrl_get(&client->dev);
+	if (IS_ERR(bt541->pinctrl)) {
+		dev_info(&client->dev, "DACE-TS: no pinctrl (%ld)\n",
+			 PTR_ERR(bt541->pinctrl));
+		bt541->pinctrl = NULL;
+	} else {
+		bt541->pins_active = pinctrl_lookup_state(bt541->pinctrl,
+							  "pmx_ts_active");
+		if (IS_ERR(bt541->pins_active))
+			bt541->pins_active = NULL;
+		bt541->pins_suspend = pinctrl_lookup_state(bt541->pinctrl,
+							   "pmx_ts_suspend");
+		if (IS_ERR(bt541->pins_suspend))
+			bt541->pins_suspend = NULL;
+		dev_info(&client->dev,
+			 "DACE-TS: pinctrl active=%d suspend=%d\n",
+			 !!bt541->pins_active, !!bt541->pins_suspend);
+	}
+
+	/* Link with the DSI panel (node 'panel' property) + notifier: the vendor
+	 * driver waits for the panel to be active before powering the chip
+	 * ("active panel selected !"). */
+	init_completion(&bt541->panel_unblank);
+	{
+		struct device_node *np = of_parse_phandle(client->dev.of_node,
+							  "panel", 0);
+		struct drm_panel *panel = np ? of_drm_find_panel(np) : NULL;
+		if (np)
+			of_node_put(np);
+		if (!IS_ERR_OR_NULL(panel)) {
+			bt541->panel = panel;
+			bt541->panel_cookie = panel_event_notifier_register(
+				PANEL_EVENT_NOTIFICATION_PRIMARY,
+				PANEL_EVENT_NOTIFIER_CLIENT_ECM, panel,
+				zinitix_panel_event_handler, bt541);
+			if (IS_ERR(bt541->panel_cookie)) {
+				dev_info(&client->dev,
+					 "DACE-TS: panel_notifier not available (%ld)\n",
+					 PTR_ERR(bt541->panel_cookie));
+				bt541->panel_cookie = NULL;
+			} else {
+				dev_info(&client->dev,
+					 "DACE-TS: registered in panel_event_notifier\n");
+			}
+		} else {
+			dev_info(&client->dev,
+				 "DACE-TS: no panel ('panel' property or of_drm_find_panel)\n");
+		}
+	}
+
+	INIT_DELAYED_WORK(&bt541->dace_poll, zinitix_dace_poll);
+
 	error = zinitix_init_regulators(bt541);
 	if (error) {
 		dev_err(&client->dev,
