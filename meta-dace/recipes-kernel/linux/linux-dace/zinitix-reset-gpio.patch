From: TicWatch Pro 5 (dace) port
Subject: [PATCH] input: touchscreen: zinitix: reset por hardware + IDs del chip

El T5 lleva un Zinitix en i2c-1 @0x20 (nodo zinitix_ts@20) con
compatible "zinitix,zinitix-ts", que el driver mainline no aceptaba (solo
"zinitix,bt541") -> se aadio por fdtput. Con eso el driver probea, y con el
vddo-supply (regulator_bulk_get pide vdd+vddo) y las touchscreen-size-x/y
(touchscreen_parse_properties) llega al final del probe.

Pero la IRQ nunca disparaba al tocar (contador 0 en /proc/interrupts) aunque el
chip RESPONDE POR I2C (zinitix_start hace su secuencia de power-on sin errores):
faltaba el RESET POR HARDWARE que el driver del vendor si hacia y el mainline no
mira. El DT del T5 lo declara con nombre de vendor (zinitix,reset-gpio =
<0x69 0x0c 0x00>, gpio 12 del TLMM); aqui se usa la propiedad ESTANDAR
(reset-gpios, que se anade por fdtput) y se pulsa el reset en zinitix_start().

Ademas se imprimen los IDs del chip (rev/fw/vendor/hw) al inicializar, para
poder confirmar que es un BT541 compatible (el node declara
zinitix,pname="SM-G5308W" y x/y_resolution=0x1d1=465, la resolucion del panel).

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/input/touchscreen/zinitix.c b/drivers/input/touchscreen/zinitix.c
index 400957f4c8c9..e9324329ed7a 100644
--- a/drivers/input/touchscreen/zinitix.c
+++ b/drivers/input/touchscreen/zinitix.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/input/mt.h>
@@ -145,6 +146,11 @@ struct bt541_ts_data {
 	struct input_dev *input_dev;
 	struct touchscreen_properties prop;
 	struct regulator_bulk_data supplies[2];
+	/* Reset por hardware: el DT del T5 declara 'zinitix,reset-gpio' (gpio 12
+	 * del TLMM) y el driver del vendor lo pulsa al arrancar. El mainline no
+	 * lo miraba: el chip respondia por i2c pero no reportaba toques (la IRQ
+	 * nunca disparaba). */
+	struct gpio_desc *reset_gpio;
 	u32 zinitix_mode;
 };
 
@@ -247,6 +253,21 @@ static int zinitix_init_touch(struct bt541_ts_data *bt541)
 		udelay(10);
 	}
 
+	/* dace: identidad del chip (para comparar con el bt541 del driver) */
+	{
+		u16 rev = 0, fw = 0, vid = 0, hwid = 0;
+		if (!zinitix_read_data(client, BT541_CHIP_REVISION, &rev, 2) &&
+		    !zinitix_read_data(client, BT541_FIRMWARE_VERSION, &fw, 2) &&
+		    !zinitix_read_data(client, BT541_VENDOR_ID, &vid, 2) &&
+		    !zinitix_read_data(client, BT541_HW_ID, &hwid, 2))
+			dev_info(&client->dev,
+				 "DACE-TS: chip rev=%u fw=%u vendor=%u hw=%u mode=%u\n",
+				 rev, fw, vid, hwid, bt541->zinitix_mode);
+		else
+			dev_info(&client->dev,
+				 "DACE-TS: no se pudieron leer los IDs del chip\n");
+	}
+
 	return 0;
 }
 
@@ -378,6 +399,9 @@ static int zinitix_start(struct bt541_ts_data *bt541)
 {
 	int error;
 
+	dev_info(&bt541->client->dev, "DACE-TS: start (open) irq=%d\n",
+		 bt541->client->irq);
+
 	error = regulator_bulk_enable(ARRAY_SIZE(bt541->supplies),
 				      bt541->supplies);
 	if (error) {
@@ -388,6 +412,20 @@ static int zinitix_start(struct bt541_ts_data *bt541)
 
 	msleep(CHIP_ON_DELAY);
 
+	/* OJO con la polaridad: gpiod_set_value usa el valor LOGICO, asi que con
+	 * reset-gpios = GPIO_ACTIVE_LOW, 1 = reset ACTIVADO (linea baja) y 0 =
+	 * liberado. (En la primera version lo puse al reves y el chip se quedaba
+	 * en reset -> el open devolvia -ENOTCONN y no habia IRQ.) */
+	if (bt541->reset_gpio) {
+		gpiod_set_value_cansleep(bt541->reset_gpio, 1);
+		msleep(20);
+		gpiod_set_value_cansleep(bt541->reset_gpio, 0);
+		msleep(150);
+		dev_info(&bt541->client->dev, "DACE-TS: reset pulsado\n");
+	}
+
+	dev_info(&bt541->client->dev, "DACE-TS: reguladores ON\n");
+
 	error = zinitix_send_power_on_sequence(bt541);
 	if (error) {
 		dev_err(&bt541->client->dev,
@@ -402,7 +440,10 @@ static int zinitix_start(struct bt541_ts_data *bt541)
 		return error;
 	}
 
+	dev_info(&bt541->client->dev, "DACE-TS: chip inicializado\n");
+
 	enable_irq(bt541->client->irq);
+	dev_info(&bt541->client->dev, "DACE-TS: irq habilitada\n");
 
 	return 0;
 }
@@ -507,6 +548,12 @@ static int zinitix_ts_probe(struct i2c_client *client)
 	bt541->client = client;
 	i2c_set_clientdata(client, bt541);
 
+	bt541->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(bt541->reset_gpio))
+		return dev_err_probe(&client->dev, PTR_ERR(bt541->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
 	error = zinitix_init_regulators(bt541);
 	if (error) {
 		dev_err(&client->dev,
