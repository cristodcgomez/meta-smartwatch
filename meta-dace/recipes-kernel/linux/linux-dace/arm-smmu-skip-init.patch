From: TicWatch Pro 5 (dace) port
Subject: [PATCH] iommu/arm-smmu: honor "qcom,skip-init" (dace bring-up)

The google-eos kernel (aurora/Pixel Watch) removed support for the
downstream "qcom,skip-init" property, which the Mobvoi stock 5.15 and the
monaco-gki 5.4 do have:

    arm-smmu.c:  { ARM_SMMU_OPT_SKIP_INIT, "qcom,skip-init" },
    arm-smmu.h:  #define ARM_SMMU_OPT_SKIP_INIT  (1 << 1)
    arm_smmu_device_reset():
        if (!(smmu->options & ARM_SMMU_OPT_SKIP_INIT) || hibernation)
                <reset of SMRn/S2CRn/CBn>

The T5 DT marks apps-smmu@0xc600000 (qcom,qsmmuv500) with qcom,skip-init:
the secure firmware (TZ) has already programmed it and Linux must NOT rewrite
it. Without the guard, loading qnoc-monaco (which registers the ICC nodes and
unblocks the apps-smmu probe) makes the driver rewrite the 40 SMRs and 50
context banks of a firmware-initialized SMMU and the SoC hard-resets to EDL,
with no oops and no pstore (seen on the USB console: last line
"arm-smmu c600000.apps-smmu: Stage-1: 36-bit VA -> 36-bit IPA").

On-screen color telemetry (dace_smmu_mark) is also added over the
continuous-splash framebuffer (0x5c000000): the panel keeps the last content
after the reset, so the remaining color identifies the last step reached of
the probe (the T5 has no UART).

Upstream-Status: Inappropriate [dace bring-up]
---
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
index b5067375dd33..13789c9282b4 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -84,6 +84,39 @@ MODULE_PARM_DESC(disable_bypass,
 
 static bool using_legacy_binding, using_generic_binding;
 
+/*
+ * dace (TicWatch Pro 5 / monaco) bring-up telemetry.
+ *
+ * Paints the full screen with a solid color over the continuous-splash
+ * framebuffer (splash_region@0x5c000000, reserved RAM WITHOUT no-map -> it is in
+ * the linear map). The panel keeps showing the last content after a hard reset
+ * to EDL, so the color left on screen identifies the last step reached. The T5
+ * has no UART.
+ *
+ *   0x101010 cfg_probe start     0x00ff00 handoff_cbs start
+ *   0x0000ff cfg_probe done      0x00ffff handoff_cbs done
+ *   0xffff00 reset start         0xff00ff reset done  0xffffff probe end
+ *   0xff0000 failure
+ */
+#define DACE_SMMU_FB_PHYS	0x5c000000ULL
+#define DACE_SMMU_FB_NPIX	(640 * 400)
+
+static void dace_smmu_mark(struct device *dev, u32 argb, const char *t)
+{
+	u32 *fb = (u32 *)phys_to_virt((phys_addr_t)DACE_SMMU_FB_PHYS);
+	size_t i;
+
+	/* The console (ttyGS0 over the ACM gadget) is the reliable channel: on the
+	 * reset to EDL the panel turns off and the screen is useless for telemetry. */
+	dev_err(dev, "DACE-SMMU %s: %s\n", dev_name(dev), t);
+
+	if (!fb)
+		return;
+	for (i = 0; i < DACE_SMMU_FB_NPIX; i++)
+		fb[i] = argb;
+	mb();
+}
+
 struct arm_smmu_option_prop {
 	u32 opt;
 	const char *prop;
@@ -91,6 +124,7 @@ struct arm_smmu_option_prop {
 
 static struct arm_smmu_option_prop arm_smmu_options[] = {
 	{ ARM_SMMU_OPT_FATAL_ASF, "qcom,fatal-asf" },
+	{ ARM_SMMU_OPT_SKIP_INIT, "qcom,skip-init" },
 	{ ARM_SMMU_OPT_3LVL_TABLES, "qcom,use-3-lvl-tables" },
 	{ ARM_SMMU_OPT_NO_ASID_RETENTION, "qcom,no-asid-retention" },
 	{ ARM_SMMU_OPT_DISABLE_ATOS, "qcom,disable-atos" },
@@ -2830,7 +2864,21 @@ static void arm_smmu_device_reset(struct arm_smmu_device *smmu)
 	/* clear global FSR */
 	reg = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_sGFSR);
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_sGFSR, reg);
+	dace_smmu_mark(smmu->dev, 0x00ffa500, "S7b reset: sGFSR OK");
 
+	/*
+	 * dace: honor "qcom,skip-init". The secure firmware (TZ) has already
+	 * programmed this SMMU (qsmmuv500) and the DT declares it. The google-eos
+	 * kernel does NOT implement the property (the Mobvoi stock 5.15 and
+	 * monaco-gki 5.4 DO: arm_smmu_options[] + this same guard), so it rewrote
+	 * SMRn/S2CRn/CBn of a SMMU already initialized by the firmware; that write
+	 * is a security violation and the SoC hard-resets to EDL (no oops, no
+	 * pstore) as soon as qnoc-monaco registers the ICC and unblocks the
+	 * apps-smmu probe. With the guard the SMMU stays as the bootloader left it
+	 * (which is what the DT asks for).
+	 */
+	if (!(smmu->options & ARM_SMMU_OPT_SKIP_INIT)) {
+		dace_smmu_mark(smmu->dev, 0x00ff00ff, "S7c reset: SMR/CB WRITES");
 #if defined CONFIG_QTI_QUIN_GVM
 	/*
 	 * Reset stream mapping groups for unused sme's: Initial values mark all SMRn as
@@ -2860,7 +2908,11 @@ static void arm_smmu_device_reset(struct arm_smmu_device *smmu)
 		arm_smmu_cb_write(smmu, i, ARM_SMMU_CB_FSR, ARM_SMMU_FSR_FAULT);
 	}
 #endif
+	} else {
+		dace_smmu_mark(smmu->dev, 0x00ff00ff, "S7c reset: SMR/CB SKIP");
+	}
 
+	dace_smmu_mark(smmu->dev, 0x008000ff, "S7d reset: TLBI OK");
 	/* Invalidate the TLB, just in case */
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_TLBIALLH, QCOM_DUMMY_VAL);
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_TLBIALLNSNH, QCOM_DUMMY_VAL);
@@ -3476,6 +3528,72 @@ err_reset_platform_ops: __maybe_unused;
 	return err;
 }
 
+/*
+ * dace (TicWatch Pro 5 / monaco): with "qcom,skip-init" the firmware/TZ left the
+ * SMR/S2CR table already programmed in the apps-smmu (the eMMC, the display and
+ * other masters have their entries) and Linux does NOT rewrite it. The problem
+ * is that smmu->smrs[]/s2crs[] start empty, so arm_smmu_find_sme() believes
+ * that ALL entries are free: arm_smmu_test_smr_masks() writes SMR(0) without
+ * the VALID bit and arm_smmu_add_device() assigns SMRs on top -> a master
+ * already configured by the firmware loses its translation. Seen on the T5:
+ * the eMMC has iommus = <&apps_smmu 0xc0 0> + qcom,iommu-dma = "bypass", and
+ * after loading qnoc "mmc0: ADMA error: 0x02000000" appears and the SoC resets
+ * to EDL. We read the live table and mark the entries in use as valid and
+ * pinned so Linux respects them.
+ */
+static void arm_smmu_mark_hw_smrs(struct arm_smmu_device *smmu)
+{
+	u32 smr, s2cr;
+	int i, used = 0, cbs = 0;
+
+	if (!smmu->smrs || !smmu->s2crs)
+		return;
+
+	for (i = 0; i < smmu->num_mapping_groups; ++i) {
+		smr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i));
+		s2cr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_S2CR(i));
+
+		if (smmu->features & ARM_SMMU_FEAT_EXIDS) {
+			if (!FIELD_GET(ARM_SMMU_S2CR_EXIDVALID, s2cr))
+				continue;
+		} else {
+			if (!FIELD_GET(ARM_SMMU_SMR_VALID, smr))
+				continue;
+		}
+
+		smmu->smrs[i].id = FIELD_GET(ARM_SMMU_SMR_ID, smr);
+		smmu->smrs[i].mask = FIELD_GET(ARM_SMMU_SMR_MASK, smr);
+		smmu->smrs[i].valid = true;
+		smmu->smrs[i].pinned = true;
+
+		smmu->s2crs[i].group = NULL;
+		smmu->s2crs[i].count = 0;
+		smmu->s2crs[i].type = FIELD_GET(ARM_SMMU_S2CR_TYPE, s2cr);
+		smmu->s2crs[i].privcfg = FIELD_GET(ARM_SMMU_S2CR_PRIVCFG, s2cr);
+		smmu->s2crs[i].cbndx = FIELD_GET(ARM_SMMU_S2CR_CBNDX, s2cr);
+		smmu->s2crs[i].pinned = true;
+
+		/*
+		 * VERY important: also reserve the firmware's CONTEXT BANK.
+		 * The downstream handoff does bitmap_set(context_map, cbndx) for this:
+		 * if we do not mark it, when Linux binds a new master (the display SDE,
+		 * e.g.) it assigns a CB the firmware ALREADY used for another master
+		 * (the eMMC) -> that one loses its context and its DMA blows up. Seen
+		 * on the T5: with the display up, the first eMMC read (fsck/mount of
+		 * mmcblk0p62) reset the SoC to EDL.
+		 */
+		if (smmu->s2crs[i].type == S2CR_TYPE_TRANS) {
+			bitmap_set(smmu->context_map, smmu->s2crs[i].cbndx, 1);
+			cbs++;
+		}
+		used++;
+	}
+
+	dev_err(smmu->dev,
+		"DACE-SMMU %s: firmware table: %d/%d SMR in use, %d context banks reserved\n",
+		dev_name(smmu->dev), used, smmu->num_mapping_groups, cbs);
+}
+
 static int arm_smmu_device_probe(struct platform_device *pdev)
 {
 	struct resource *res;
@@ -3560,9 +3678,13 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
+	dace_smmu_mark(dev, 0x00101010, "S1 cfg_probe START");
 	err = arm_smmu_device_cfg_probe(smmu);
-	if (err)
+	if (err) {
+		dace_smmu_mark(dev, 0x00ff0000, "S1 cfg_probe FAILURE");
 		goto out_power_off;
+	}
+	dace_smmu_mark(dev, 0x000000ff, "S2 cfg_probe OK");
 
 	err = arm_smmu_parse_impl_def_registers(smmu);
 	if (err)
@@ -3606,10 +3728,17 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 		goto out_power_off;
 	smmu->phys_addr = res->start;
 	parse_driver_options(smmu);
+	if (smmu->options & ARM_SMMU_OPT_SKIP_INIT)
+		arm_smmu_mark_hw_smrs(smmu);
+	dace_smmu_mark(dev, 0x0000ff00, "S3 handoff_cbs START");
 	err = arm_smmu_handoff_cbs(smmu);
-	if (err)
+	if (err) {
+		dace_smmu_mark(dev, 0x00ff0000, "S3 handoff_cbs FAILURE");
 		goto out_power_off;
+	}
+	dace_smmu_mark(dev, 0x0000ffff, "S4 handoff_cbs OK");
 
+	dace_smmu_mark(dev, 0x00808000, "S5 sysfs_add START");
 	err = iommu_device_sysfs_add(&smmu->iommu, smmu->dev, NULL,
 				     "smmu.%pa", &ioaddr);
 	if (err) {
@@ -3623,10 +3752,15 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 		goto err_sysfs_remove;
 	}
 
+	dace_smmu_mark(dev, 0x00808080, "S6 iommu_registered OK");
 	platform_set_drvdata(pdev, smmu);
+	dace_smmu_mark(dev, 0x00ffff00, "S7 reset START");
 	arm_smmu_device_reset(smmu);
+	dace_smmu_mark(dev, 0x00ffffff, "S9 reset DONE");
+	dace_smmu_mark(dev, 0x0000ff80, "S9a test_smr_masks START");
 	arm_smmu_test_smr_masks(smmu);
 	arm_smmu_interrupt_selftest(smmu);
+	dace_smmu_mark(dev, 0x0010ff10, "S9b test_smr_masks DONE");
 
 	/*
 	 * We want to avoid touching dev->power.lock in fastpaths unless
@@ -3649,11 +3783,14 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 	 * ready to handle default domain setup as soon as any SMMU exists.
 	 */
 	if (!using_legacy_binding) {
+		dace_smmu_mark(dev, 0x00ff00ff, "S10 bus_init START");
 		err = arm_smmu_bus_init(&arm_smmu_ops.iommu_ops);
 		if (err)
 			goto err_unregister_device;
+		dace_smmu_mark(dev, 0x0010ff10, "S11 bus_init OK");
 	}
 
+	dace_smmu_mark(dev, 0x0000ffff, "S12 probe END OK");
 	return 0;
 
 err_unregister_device:
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.h b/drivers/iommu/arm/arm-smmu/arm-smmu.h
index 5bb6e5bd2c06..1427a91570f9 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.h
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.h
@@ -376,6 +376,7 @@ struct arm_smmu_device {
 	u32				features;
 
 #define ARM_SMMU_OPT_FATAL_ASF		(1 << 0)
+#define ARM_SMMU_OPT_SKIP_INIT		(1 << 1)
 #define ARM_SMMU_OPT_3LVL_TABLES	(1 << 2)
 #define ARM_SMMU_OPT_NO_ASID_RETENTION	(1 << 3)
 #define ARM_SMMU_OPT_DISABLE_ATOS	(1 << 4)
