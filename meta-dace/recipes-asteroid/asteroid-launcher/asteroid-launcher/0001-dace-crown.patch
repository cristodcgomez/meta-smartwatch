From: dace bring-up <dace@localhost>
Subject: [PATCH] dace: launcher consume la corona (rueda REL_WHEEL + pulsador KEY_MENU)

La rueda de la corona (slate-spi, event2) llega como QWheelEvent a traves del
plugin generico evdevmouse de Qt, pero el estilo por defecto del launcher
(000-default-horizontal.qml) no tiene WheelHandler -> la lista de apps no se
movia. El pulsador de la corona emite KEY_MENU (139) en event0 (gpio-keys) y
tampoco se consumia. Ambos son especificos del hardware de esta variante
(dace / TicWatch Pro 5 con el MCU slate), no upstreamables.

Upstream-Status: Inappropriate [dace bring-up]

---
diff --git a/src/applauncher/000-default-horizontal.qml b/src/applauncher/000-default-horizontal.qml
index cdcd723..46d9cd6 100644
--- a/src/applauncher/000-default-horizontal.qml
+++ b/src/applauncher/000-default-horizontal.qml
@@ -42,6 +42,31 @@ Item {
     property bool fakePressed: false
 
     anchors.fill: parent
+
+    /* dace/CORONA (22-09-2026): la rueda lateral (slate-spi, event2) llega como
+     * QWheelEvent via el plugin generico evdevmouse de Qt. El ListView no la
+     * consume sola, asi que avanzamos/retrocedemos un item por "diente"
+     * (angleDelta = 120 por notch). Si el sentido sale invertido, cambiar el
+     * signo de `steps`. */
+    function launchSelected() {
+        var it = launcherModel.get(appsListView.currentPos)
+        if (it && it.object)
+            it.object.launchApplication()
+    }
+
+    WheelHandler {
+        id: crownWheel
+        onWheel: (event) => {
+            var steps = Math.round(event.angleDelta.y / 120.0)
+            if (steps !== 0) {
+                var n = Math.max(0, Math.min(appsListView.count - 1,
+                                             appsListView.currentPos + steps))
+                appsListView.positionViewAtIndex(n, ListView.Center)
+            }
+            event.accepted = true
+        }
+    }
+
     ListView {
         id: appsListView
 
diff --git a/src/applauncher/005-speed-dial.qml b/src/applauncher/005-speed-dial.qml
index 8652837..2abfcba 100644
--- a/src/applauncher/005-speed-dial.qml
+++ b/src/applauncher/005-speed-dial.qml
@@ -27,6 +27,12 @@ Item {
     id: root
     property int itemIndexOffset: 4
     property var selectedLauncherItem: null
+
+    // dace/CORONA: activar la app seleccionada desde el pulsador de la corona.
+    function launchSelected() {
+        if (selectedLauncherItem && selectedLauncherItem.launchApplication)
+            selectedLauncherItem.launchApplication()
+    }
     // Scaling for when the launcher is shown as full screen (1.0) or in the settings app (0.5).
     property var viewScale: (root.width > root.height ? root.height : root.width) / Dims.l(100)
     property alias currentIndex: pv.currentIndex
@@ -230,7 +236,10 @@ Item {
 
         WheelHandler {
             property: "offset"
-            rotationScale: (1 / 15) * 0.01
+            /* dace/CORONA (22-09-2026): (1/15)*0.01 daba 0.01 item por notch
+             * (~100 notches por item): la rueda parecia muerta. 1/15 = un item
+             * por diente (rotation = 15 grados por notch; offset esta en items). */
+            rotationScale: 1 / 15
             onRotationChanged: snapTimer.restart()
         }
 
diff --git a/src/qml/MainScreen.qml b/src/qml/MainScreen.qml
index 3d78ce9..49aa743 100644
--- a/src/qml/MainScreen.qml
+++ b/src/qml/MainScreen.qml
@@ -48,6 +48,25 @@ Item {
     visible: Lipstick.compositor.homeActive || aboutToOpen || aboutToClose || aboutToMinimize
     enabled: visible
 
+    /* dace/CORONA (22-09-2026): el pulsador de la corona emite KEY_MENU (139) en
+     * /dev/input/event0 (gpio-keys, driver del vendor). Qt lo entrega como
+     * Qt.Key_Menu. Si la lista de apps esta abierta, activa la app seleccionada;
+     * si no, abre la lista. Requiere foco de teclado en la escena home. */
+    focus: visible
+    Keys.onPressed: (event) => {
+        if (event.key === Qt.Key_Menu) {
+            event.accepted = true
+            if (grid.currentVerticalPos === 1) {
+                if (Desktop.appLauncher && Desktop.appLauncher.launchSelected)
+                    Desktop.appLauncher.launchSelected()
+                else
+                    grid.moveTo(0, 0)
+            } else {
+                grid.moveTo(0, 1)
+            }
+        }
+    }
+
     // Requests the active watchface Loader to reload from disk. A signal, so
     // the handler can live in the Loader's own scope.
     signal watchfaceReloadRequested()
