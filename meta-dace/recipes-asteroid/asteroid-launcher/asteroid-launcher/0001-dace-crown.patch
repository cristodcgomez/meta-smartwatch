diff --git a/src/applauncher/000-default-horizontal.qml b/src/applauncher/000-default-horizontal.qml
index cdcd723..c4da376 100644
--- a/src/applauncher/000-default-horizontal.qml
+++ b/src/applauncher/000-default-horizontal.qml
@@ -42,6 +42,45 @@ Item {
     property bool fakePressed: false
 
     anchors.fill: parent
+
+    /* dace/CORONA (22-09-2026): la rueda lateral (slate-spi, event2) llega como
+     * QWheelEvent via el plugin generico evdevmouse de Qt. El ListView no la
+     * consume sola, asi que avanzamos/retrocedemos un item por "diente"
+     * (angleDelta = 120 por notch). Si el sentido sale invertido, cambiar el
+     * signo de `steps`. */
+    function launchSelected() {
+        var idx = Math.round(appsListView.contentX / appsListView.width)
+        idx = Math.max(0, Math.min(appsListView.count - 1, idx))
+        console.log("dace crown: launchSelected idx=" + idx + " count=" + appsListView.count)
+        var it = launcherModel.get(idx)
+        if (it && it.object)
+            it.object.launchApplication()
+        else
+            console.log("dace crown: launchSelected sin objeto")
+    }
+
+    WheelHandler {
+        id: crownWheel
+        property real daceAccum: 0
+        // dace/CORONA: encoder continuo -> daceDiv eventos por item.
+        readonly property int daceDiv: 3
+        onWheel: (event) => {
+            daceAccum += event.angleDelta.y / 120.0
+            var steps = 0
+            while (daceAccum >= daceDiv)  { daceAccum -= daceDiv; steps += 1 }
+            while (daceAccum <= -daceDiv) { daceAccum += daceDiv; steps -= 1 }
+            if (steps !== 0) {
+                // OJO: este ListView tiene `contentX: tutorialScroll` (binding a 0),
+                // asi que positionViewAtIndex no movia nada. Se asigna contentX
+                // directamente (la asignacion desde JS rompe el binding).
+                var cur = Math.round(appsListView.contentX / appsListView.width)
+                var n = Math.max(0, Math.min(appsListView.count - 1, cur + steps))
+                appsListView.contentX = n * appsListView.width
+            }
+            event.accepted = true
+        }
+    }
+
     ListView {
         id: appsListView
 
