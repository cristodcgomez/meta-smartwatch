@@ -229,9 +235,22 @@ Item {
         }
 
         WheelHandler {
-            property: "offset"
-            rotationScale: (1 / 15) * 0.01
-            onRotationChanged: snapTimer.restart()
+            id: crownWheel
+            property real daceAccum: 0
+            // dace/CORONA: encoder continuo; daceDiv eventos por item (antes
+            // (1/15)*0.01 daba 0.01 item/notch: la rueda parecia muerta).
+            readonly property int daceDiv: 3
+            onWheel: (event) => {
+                daceAccum += event.angleDelta.y / 120.0
+                var steps = 0
+                while (daceAccum >= daceDiv)  { daceAccum -= daceDiv; steps += 1 }
+                while (daceAccum <= -daceDiv) { daceAccum += daceDiv; steps -= 1 }
+                if (steps !== 0) {
+                    offset = Math.round(offset) + steps
+                    snapTimer.restart()
+                }
+                event.accepted = true
+            }
         }
 
         Timer {
diff --git a/src/crownbuttonhandler.cpp b/src/crownbuttonhandler.cpp
new file mode 100644
index 0000000..64f0b40
--- /dev/null
+++ b/src/crownbuttonhandler.cpp
@@ -0,0 +1,27 @@
+/*
+ * dace (TicWatch Pro 5): pulsador de la corona. Ver crownbuttonhandler.h.
+ */
+
+#include "crownbuttonhandler.h"
+
+#include <QEvent>
+#include <QKeyEvent>
+
+CrownButtonHandler::CrownButtonHandler(QObject *parent) : QObject(parent)
+{
+}
+
+bool CrownButtonHandler::eventFilter(QObject *obj, QEvent *event)
+{
+    if (event->type() == QEvent::KeyPress) {
+        QKeyEvent *ke = static_cast<QKeyEvent *>(event);
+        // Key_MenuKB es a lo que el keymap de AsteroidOS mapea KEY_MENU (139).
+        // Key_Menu se acepta tambien por si cambia el keymap.
+        if (!ke->isAutoRepeat() &&
+            (ke->key() == Qt::Key_MenuKB || ke->key() == Qt::Key_Menu)) {
+            emit pressed();
+            return true; // consumida: no la reenviamos a la escena
+        }
+    }
+    return QObject::eventFilter(obj, event);
+}
\ No newline at end of file
diff --git a/src/crownbuttonhandler.h b/src/crownbuttonhandler.h
new file mode 100644
index 0000000..15a18d4
--- /dev/null
+++ b/src/crownbuttonhandler.h
@@ -0,0 +1,31 @@
+/*
+ * dace (TicWatch Pro 5): pulsador de la corona.
+ *
+ * El pulsador emite KEY_MENU (139) en /dev/input/event0 (gpio-keys). El keymap
+ * de AsteroidOS lo mapea a Qt::Key_MenuKB. La escena "home" del launcher NO
+ * recibe foco de teclado (MainScreen.crownPressed() nunca se disparaba con
+ * Keys.onPressed), asi que la tecla se captura con un filtro de eventos global
+ * instalado en la QGuiApplication -- el mismo patron que usa lipstick para los
+ * botones de volumen (VolumeControl::eventFilter). Al recibirla se emite
+ * `pressed()`, que compositor.qml reenvia a MainScreen.
+ */
+#ifndef CROWNBUTTONHANDLER_H
+#define CROWNBUTTONHANDLER_H
+
+#include <QObject>
+
+class CrownButtonHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit CrownButtonHandler(QObject *parent = nullptr);
+
+signals:
+    void pressed();
+
+protected:
+    bool eventFilter(QObject *obj, QEvent *event) override;
+};
+
+#endif // CROWNBUTTONHANDLER_H
\ No newline at end of file
diff --git a/src/main.cpp b/src/main.cpp
index c676c4d..bb98577 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -46,6 +46,7 @@
 #include "notificationsnoozer.h"
 #include "applauncher.h"
 #include "watchfacereloader.h"
+#include "crownbuttonhandler.h"
 
 int main(int argc, char **argv)
 {
@@ -92,6 +93,14 @@ int main(int argc, char **argv)
     qmlRegisterType<NotificationSnoozer>("org.asteroid.launcher", 1, 0, "NotificationSnoozer");
     qmlRegisterType<AppLauncher>("org.asteroid.launcher", 1, 0, "AppLauncher");
 
+    /* dace: pulsador de la corona (KEY_MENU -> Qt::Key_MenuKB). La escena home
+     * no recibe foco de teclado, asi que se captura con un filtro de eventos
+     * GLOBAL (mismo patron que lipstick/VolumeControl). compositor.qml conecta
+     * a su signal `pressed` y llama a MainScreen.crownPressed(). */
+    CrownButtonHandler *crownButton = new CrownButtonHandler();
+    app.installEventFilter(crownButton);
+    app.engine()->rootContext()->setContextProperty("crownButton", crownButton);
+
     // Give these to the environment inside the launcher's wayland compositor
     // Fixes a bug where some applications wouldn't launch, eg. terminal or browser
     setenv("EGL_PLATFORM", "wayland", 1);
diff --git a/src/qml/MainScreen.qml b/src/qml/MainScreen.qml
index 3d78ce9..e3f4da1 100644
--- a/src/qml/MainScreen.qml
+++ b/src/qml/MainScreen.qml
@@ -48,6 +48,28 @@ Item {
     visible: Lipstick.compositor.homeActive || aboutToOpen || aboutToClose || aboutToMinimize
     enabled: visible
 
+    /* dace/CORONA (22-09-2026): el pulsador de la corona. Lo entrega el filtro
+     * de eventos GLOBAL (CrownButtonHandler, src/main.cpp): esta escena NO
+     * recibe foco de teclado, con Keys.onPressed la tecla nunca llegaba.
+     * compositor.qml reenvia su signal `pressed` aqui como crownPressed().
+     * Si la lista de apps esta abierta, activa la app seleccionada; si no, la
+     * abre. */
+    function crownPressed() {
+        if (!visible)
+            return
+        console.log("dace crown: crownPressed vpos=" + grid.currentVerticalPos
+                    + " appLauncher=" + (Desktop.appLauncher ? "si" : "no")
+                    + " launchSelected=" + (Desktop.appLauncher && Desktop.appLauncher.launchSelected ? "si" : "no"))
+        if (grid.currentVerticalPos === 1) {
+            if (Desktop.appLauncher && Desktop.appLauncher.launchSelected)
+                Desktop.appLauncher.launchSelected()
+            else
+                grid.moveTo(0, 0)
+        } else {
+            grid.moveTo(0, 1)
+        }
+    }
+
     // Requests the active watchface Loader to reload from disk. A signal, so
     // the handler can live in the Loader's own scope.
     signal watchfaceReloadRequested()
