[Unit]
Description=dace: persistent power/suspend log (to verify without adb)
Documentation=file:///usr/libexec/dace-powerlog.sh
After=multi-user.target
ConditionPathExists=/sys/class/power_supply

[Service]
Type=simple
ExecStart=/usr/libexec/dace-powerlog.sh
Restart=always
RestartSec=10
# Do not write to journald (it gets stuck): the script writes to /var/log/dace-power.log
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target